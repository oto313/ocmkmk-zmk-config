if BOARD_OCDMK_CORE

config ZMK_KEYBOARD_NAME
    default "OCDMK"

config USB_DEVICE_PRODUCT
    default "OCDMK Core"

config USB_DEVICE_VID
    default 0x1D50

config USB_DEVICE_PID
    default 0x615E

config USB_DEVICE_MANUFACTURER
    default "OCDMK"

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

endif # BOARD_OCDMK_CORE

