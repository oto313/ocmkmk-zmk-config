# SPDX-License-Identifier: MIT

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y



CONFIG_ZMK_SPLIT=y

CONFIG_SERIAL=y
# Do not force UART0 async-only: wired split uses interrupt API (mutually exclusive on nRF UARTE).
CONFIG_NRFX_UARTE0=y
CONFIG_ZMK_SPLIT_WIRED=y
CONFIG_ZMK_SPLIT_WIRED_UART_MODE_INTERRUPT=y
CONFIG_MAIN_STACK_SIZE=4048
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4048

CONFIG_NFCT_PINS_AS_GPIOS=y