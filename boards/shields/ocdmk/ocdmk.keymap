
/*
 * OCDMK Default Keymap
 * 7×4 split keyboard (14 columns total)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>
/ {
    behaviors {
        bootload_uf2: bootload_uf2 {
            compatible = "zmk,behavior-bootloader";
            #binding-cells = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Standard QWERTY
             * Row 0: TAB    Q  W  E  R  T  ESC    |  MINUS  Y  U  I  O  P  BSLH
             * Row 1: MO1    A  S  D  F  G  LBKT   |  RBKT   H  J  K  L  ;  MO1
             * Row 2:           Z  X  C  V  B      |         N  M  ,  .  /
             * Row 3: LSHFT  LGUI  SPC             |              BSPC  ENT  RALT
             */
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp ESC          &kp MINUS  &kp Y  &kp U      &kp I      &kp O    &kp P     &kp BSLH
                &mo 1      &kp A  &kp S  &kp D  &kp F  &kp G  &kp LBKT         &kp RBKT   &kp H  &kp J      &kp K      &kp L    &kp SEMI  &mo 1
                           &kp Z  &kp X  &kp C  &kp V  &kp B                               &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH
                &kp LSHFT  &kp LGUI  &kp SPACE                                                     &kp BSPC   &kp ENTER  &kp RALT
            >;
        };

        lower_layer {
            /* Numbers, symbols, and function keys
             * Row 0: GRAVE  1  2  3  4  5  F11    |  F12    6  7  8  9  0  EQUAL
             * Row 1: MO2    !  @  #  $  %  BL+    |  BL-    ^  &  *  (  )  MO2
             * Row 2:           F1 F2 F3 F4 F5     |        F6 F7 F8 F9 F10
             * Row 3: STUDIO LCTRL  BOOTLD         |              BOOTLD  DEL  SQT
             * (hold both MO1 keys to reach the Bluetooth layer)
             */
            bindings = <
                &kp GRAVE  &kp N1    &kp N2  &kp N3  &kp N4    &kp N5     &kp F11        &kp F12        &kp N6     &kp N7    &kp N8    &kp N9    &kp N0    &kp EQUAL
                &mo 2      &kp EXCL  &kp AT  &kp HASH &kp DLLR &kp PRCNT  &bl BL_INC     &bl BL_DEC     &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &mo 2
                           &kp F1    &kp F2  &kp F3  &kp F4    &kp F5                                   &kp F6     &kp F7    &kp F8    &kp F9    &kp F10
                &studio_unlock  &bl BL_TOG  &bootload_uf2                                                           &bootload_uf2  &kp DEL  &bl BL_TOG
            >;
        };

        bt_layer {
            /* Bluetooth profiles (hold both MO1 keys)
             * Row 0: --  BT0  BT1  BT2  BT3  BT4  --  |  --  --  --  --  --  --  --
             * Row 1: --  CLR  --   --   --   --   --  |  --  --  --  --  --  --  --
             * Row 2:     PRV  NXT  --   --   CLR_ALL  |      --  --  --  --  --
             * Row 3: --  --   --                      |              --  --  --
             * CLR clears the bond of the selected profile; CLR_ALL clears every host profile.
             */
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &bt BT_CLR    &trans        &trans        &trans        &trans        &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &bt BT_PRV    &bt BT_NXT    &trans        &trans        &bt BT_CLR_ALL                   &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                                                                                   &trans  &trans  &trans
            >;
        };
    };
};
