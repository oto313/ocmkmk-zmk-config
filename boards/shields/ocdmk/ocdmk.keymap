/*
 * OCDMK Default Keymap
 * 7×4 split keyboard (14 columns total)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h>
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Left: cols 0–6, right: 7–13 (per default_transform + right col-offset).
             * Row 0: BL Q W E R T PGUP | Y U I O P [ BL
             * Row 1: MO A S D F G PGDN | R S T U V W X
             * Row 2: Z X C V B | 3 4 5 6 7
             * Row 3: BSPC ENT SPC | ; ' ENT
             */
            bindings = <
                &bl BL_TOG  &kp Q  &kp W   &kp E     &kp R     &kp T     &kp PAGE_UP                        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT   &bl BL_TOG
                &mo 1       &kp A       &kp S        &kp D     &kp F     &kp G     &kp PAGE_DOWN            &kp R     &kp S     &kp T     &kp U     &kp V     &kp W    &kp X
                            &kp Z        &kp X     &kp C    &kp V    &kp B                                            &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    
                &kp BACKSPACE    &kp ENTER  &kp SPACE                                                                                               &kp SEMI  &kp SQT  &kp ENTER
            >;
        };

        lower_layer {
            /* Test keymap layer 2: Numbers and symbols for testing
             * Row 0: ! @ # $ % | ^ & * (
             * Row 1: ) _ + { } | : " < > ?
             * Row 2: ~ ` | } { | | | | | | |
             * Row 3: | | | | | | |
             */
            bindings = <
                &bl BL_INC   &bl BL_DEC   &kp HASH   &kp DLLR   &kp PRCNT   &kp CARET   &kp AMPS           &kp STAR   &kp LPAR   &kp RPAR   &kp PLUS   &kp UNDER   &kp COLON   &kp DQT
                &kp RPAR  &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp COLON &kp DQT            &kp LT     &kp GT     &kp QMARK  &kp TILDE  &kp GRAVE  &kp PIPE
                            &kp GRAVE &kp PIPE  &kp RBRC  &kp LBRC  &kp PIPE                                              &kp PIPE     &kp PIPE     &kp PIPE     &kp PIPE     &kp PIPE
                &studio_unlock  &kp PIPE   &kp PIPE                                                                     &kp PIPE  &kp PIPE  &kp PIPE
            >;
        };
    };
};
