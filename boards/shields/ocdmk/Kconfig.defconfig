if SHIELD_OCDMK_LEFT

config ZMK_KEYBOARD_NAME
    default "ocdmk"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_OCDMK_LEFT

if SHIELD_OCDMK_LEFT || SHIELD_OCDMK_RIGHT

config ZMK_SPLIT
    default y

config ZMK_BACKLIGHT
    default y
    select PWM
    select LED_PWM

endif # SHIELD_OCDMK_LEFT || SHIELD_OCDMK_RIGHT
