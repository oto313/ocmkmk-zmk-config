{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OCDMK Left",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-d",
                "build_ocdmk_left",
                "-s",
                "${workspaceFolder}/zmk/app",
                "-b",
                "ocdmk_core",
                "-S",
                "studio-rpc-usb-uart",
                "--",
                "-DSHIELD=ocdmk_left",
                "-DZMK_CONFIG=${workspaceFolder}",
                "-DZMK_EXTRA_MODULES=${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/zmk/app"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build OCDMK Left (Pristine)",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-p",
                "-d",
                "build_ocdmk_left",
                "-s",
                "${workspaceFolder}/zmk/app",
                "-b",
                "ocdmk_core",
                "--",
                "-DSHIELD=ocdmk_left",
                "-DZMK_CONFIG=${workspaceFolder}",
                "-DZMK_EXTRA_MODULES=${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/zmk/app"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash OCDMK Left (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
                "-d",
                "build_ocdmk_left",
                "--runner",
                "jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/zmk/app"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Flash OCDMK Left",
            "dependsOn": [
                "Build OCDMK Left",
                "Flash OCDMK Left (J-Link)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Build OCDMK Right",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-d",
                "build_ocdmk_right",
                "-s",
                "${workspaceFolder}/zmk/app",
                "-b",
                "ocdmk_core",
                "-S",
                "studio-rpc-usb-uart",
                "--",
                "-DSHIELD=ocdmk_right",
                "-DZMK_CONFIG=${workspaceFolder}",
                "-DZMK_EXTRA_MODULES=${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/zmk/app"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash OCDMK Right (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
                "-d",
                "build_ocdmk_right",
                "--runner",
                "jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/zmk/app"
            },
            "problemMatcher": []
        },
        {
            "label": "Build and Flash OCDMK Right",
            "dependsOn": [
                "Build OCDMK Right",
                "Flash OCDMK Right (J-Link)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
    ]
}


